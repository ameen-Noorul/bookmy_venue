generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum VenueStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  name        String?
  phone       String?
  avatarUrl   String?   @map("avatar_url")
  role        Role      @default(USER)
  isVerified  Boolean   @default(true) @map("is_verified")
  isBanned    Boolean   @default(false) @map("is_banned")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  venues      Venue[]
  bookings    Booking[]
  reviews     Review[]
  notifications Notification[]
  refreshTokens RefreshToken[]

  @@map("users")
}
model Venue {
  id                 String      @id @default(uuid())
  ownerId            String      @map("owner_id")
  name               String
  description        String?
  address            String
  city               String
  state              String
  pincode            String
  latitude           Float?
  longitude          Float?
  capacity           Int
  pricePerDay        Decimal     @map("price_per_day") @db.Decimal(10, 2)
  amenities          String[]
  photos             String[]
  status             VenueStatus @default(DRAFT)
  cancellationPolicy Json?       @map("cancellation_policy")
  rules              String?
  approvedAt         DateTime?   @map("approved_at")
  approvedBy         String?     @map("approved_by")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  owner              User               @relation(fields: [ownerId], references: [id])
  bookings           Booking[]
  availability       VenueAvailability[]
  reviews            Review[]

  @@map("venues")
}

model VenueAvailability {
  id          String    @id @default(uuid())
  venueId     String    @map("venue_id")
  blockedDate DateTime  @map("blocked_date") @db.Date
  reason      String?
  createdAt   DateTime  @default(now()) @map("created_at")

  venue       Venue     @relation(fields: [venueId], references: [id])

  @@unique([venueId, blockedDate])
  @@map("venue_availability")
}

model Booking {
  id              String        @id @default(uuid())
  venueId         String        @map("venue_id")
  userId          String        @map("user_id")
  eventDate       DateTime      @map("event_date") @db.Date
  eventEndDate    DateTime      @map("event_end_date") @db.Date
  eventType       String        @map("event_type")
  guestCount      Int           @map("guest_count")
  totalAmount     Decimal       @map("total_amount") @db.Decimal(10, 2)
  platformFee     Decimal       @map("platform_fee") @db.Decimal(10, 2)
  ownerAmount     Decimal       @map("owner_amount") @db.Decimal(10, 2)
  status          BookingStatus @default(PENDING)
  ownerNote       String?       @map("owner_note")
  policySnapshot  Json          @map("policy_snapshot")
  version         Int           @default(0)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  venue           Venue         @relation(fields: [venueId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  payment         Payment?
  review          Review?
  @@unique([venueId, eventDate])
  @@index([userId])
  @@map("bookings")
}

model Payment {
  id                  String        @id @default(uuid())
  bookingId           String        @unique @map("booking_id")
  razorpayOrderId     String?       @unique @map("razorpay_order_id")
  razorpayPaymentId   String?       @unique @map("razorpay_payment_id")
  amount              Decimal       @db.Decimal(10, 2)
  currency            String        @default("INR")
  status              PaymentStatus @default(PENDING)
  payoutStatus        String?       @map("payout_status")
  payoutAt            DateTime?     @map("payout_at")
  refundAmount        Decimal?      @map("refund_amount") @db.Decimal(10, 2)
  refundAt            DateTime?     @map("refund_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  booking             Booking       @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Review {
  id          String    @id @default(uuid())
  bookingId   String    @unique @map("booking_id")
  venueId     String    @map("venue_id")
  userId      String    @map("user_id")
  rating      Int
  comment     String?
  ownerReply  String?   @map("owner_reply")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  booking     Booking   @relation(fields: [bookingId], references: [id])
  venue       Venue     @relation(fields: [venueId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@map("reviews")
}
model Notification {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id])
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerId])
  @@map("notifications")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tokenHash   String   @unique   // never store raw token
  familyId    String              // groups all rotations of one login session
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?           // set when rotated OR reuse-detected

  @@index([userId])
  @@index([familyId])
}